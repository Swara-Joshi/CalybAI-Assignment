# Application configuration
APP_NAME=agent-research-knowledge-system
APP_ENV=development
LOG_LEVEL=INFO

# Optional data source configuration
RESEARCH_DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
KNOWLEDGE_STATE_DIR=./data/knowledge_state

# API configuration placeholders
OPENAI_API_KEY=
HF_TOKEN=

# Network / HTTP settings
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# Optional local service settings
HTTPX_VERIFY_SSL=true
